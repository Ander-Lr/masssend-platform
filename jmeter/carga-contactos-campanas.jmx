        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Confirmar doble factor" enabled="true">
          <stringProp name="HTTPSampler.path">/api/v1/mfa/confirmar</stringProp>
