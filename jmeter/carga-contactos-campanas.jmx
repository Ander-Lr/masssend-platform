        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Compartir token con los hilos" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Los hilos de carga leen el token desde las propiedades de JMeter.
String acceso = vars.get(&apos;acceso&apos;)
if (!acceso || acceso == &apos;NO_ENCONTRADO&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&apos;La preparacion no obtuvo el token de acceso.&apos;)
} else {
    props.put(&apos;acceso&apos;, acceso)
    SampleResult.setResponseData(&apos;Token listo para los hilos de carga.&apos;, &apos;UTF-8&apos;)
}</stringProp>
        </JSR223Sampler>
