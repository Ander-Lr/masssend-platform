        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Datos de la vuelta" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.concurrent.ThreadLocalRandom

// Cada vuelta crea un contacto con una etiqueta propia, para que su campana
// tenga un solo destinatario y cueste un credito.
String corrida = vars.get(&apos;TESTSTART.MS&apos;) ?: props.get(&apos;START.MS&apos;) ?: &apos;0&apos;
vars.put(&apos;etiqueta&apos;, &apos;c&apos; + corrida + &apos;t&apos; + ctx.getThreadNum() + &apos;i&apos; + vars.getIteration())
vars.put(&apos;telefono&apos;, &apos;09&apos; + String.format(&apos;%08d&apos;, ThreadLocalRandom.current().nextInt(100000000)))</stringProp>
          </JSR223PreProcessor>
