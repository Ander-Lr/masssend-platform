        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Leer codigo del correo" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonSlurper

// El trabajador de correos envia en segundo plano: se espera hasta 15 s.
def base = vars.get(&apos;mailpit&apos;)
def consulta = URLEncoder.encode(&apos;to:&apos; + vars.get(&apos;correo&apos;), &apos;UTF-8&apos;)
def json = new JsonSlurper()
String codigo = null
for (int i = 0; i &lt; 50 &amp;&amp; codigo == null; i++) {
    def lista = json.parseText(new URL(base + &apos;/api/v1/search?query=&apos; + consulta).getText(&apos;UTF-8&apos;))
    if (lista.messages) {
        def mensaje = json.parseText(new URL(base + &apos;/api/v1/message/&apos; + lista.messages[0].ID).getText(&apos;UTF-8&apos;))
        def hallado = (mensaje.Text =~ /\b(\d{6})\b/)
        if (hallado.find()) {
            codigo = hallado.group(1)
        }
    }
    if (codigo == null) {
        Thread.sleep(300)
    }
}
if (codigo == null) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&apos;No llego el correo de verificacion a &apos; + vars.get(&apos;correo&apos;) + &apos; (revisa que el perfil ci este levantado)&apos;)
} else {
    vars.put(&apos;codigo&apos;, codigo)
    SampleResult.setResponseData(&apos;Codigo recibido: &apos; + codigo, &apos;UTF-8&apos;)
}</stringProp>
        </JSR223Sampler>
