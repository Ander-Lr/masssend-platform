        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Calcular codigo TOTP" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec
import java.nio.ByteBuffer

// TOTP de RFC 6238 (SHA-1, 30 s, 6 digitos), lo mismo que Google Authenticator.
String alfabeto = &apos;ABCDEFGHIJKLMNOPQRSTUVWXYZ234567&apos;
String secreto = vars.get(&apos;secreto&apos;).replace(&apos;=&apos;, &apos;&apos;).toUpperCase()
ByteArrayOutputStream llave = new ByteArrayOutputStream()
int buffer = 0
int bits = 0
for (char c : secreto.toCharArray()) {
    buffer = (buffer &lt;&lt; 5) | alfabeto.indexOf((int) c)
    bits += 5
    if (bits &gt;= 8) {
        llave.write((buffer &gt;&gt; (bits - 8)) &amp; 0xFF)
        bits -= 8
    }
}
long paso = System.currentTimeMillis().intdiv(30000L)
Mac mac = Mac.getInstance(&apos;HmacSHA1&apos;)
mac.init(new SecretKeySpec(llave.toByteArray(), &apos;HmacSHA1&apos;))
byte[] h = mac.doFinal(ByteBuffer.allocate(8).putLong(paso).array())
int o = h[h.length - 1] &amp; 0x0F
int binario = ((h[o] &amp; 0x7F) &lt;&lt; 24) | ((h[o + 1] &amp; 0xFF) &lt;&lt; 16) | ((h[o + 2] &amp; 0xFF) &lt;&lt; 8) | (h[o + 3] &amp; 0xFF)
vars.put(&apos;codigoTotp&apos;, String.format(&apos;%06d&apos;, binario % 1000000))</stringProp>
          </JSR223PreProcessor>
