    {
      "name": "Pagos",
      "item": [
        {
          "name": "Checkout con monto alterado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{acceso}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pagos/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pagos",
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"paquete_id\": {{paqueteId}}, \"pasarela\": \"paypal\", \"monto\": \"0.01\", \"creditos\": 999999}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const c = pm.response.json();",
                  "pm.test(\"Se ignora el monto del cliente\", () => pm.expect(c.monto).to.eql(pm.environment.get(\"paquetePrecio\")));",
                  "pm.test(\"Se ignoran los creditos del cliente\", () => pm.expect(c.creditos).to.eql(pm.environment.get(\"paqueteCreditos\")));",
                  "pm.test(\"El id es UUIDv7\", () => pm.expect(c.compra_id[14]).to.eql(\"7\"));",
                  "pm.environment.set('compraId', c.compra_id);",
                  "if (pm.environment.get('modoPago') === 'paypal') {",
                  "  pm.test(\"Lleva a PayPal Sandbox\", () => pm.expect(c.url_pago).to.match(/^https:\\/\\/www\\.sandbox\\.paypal\\.com\\//));",
                  "  console.log('Modo paypal: abre esta URL, paga con tu cuenta personal de Sandbox y luego ejecuta Confirmar: ' + c.url_pago);",
                  "} else {",
                  "  pm.test(\"Usa la pasarela simulada\", () => pm.expect(c.url_pago).to.match(/^https:\\/\\/pasarela\\.falsa\\//));",
                  "}"
                ]
              }
            }
          ]
        },
