            "url": {
              "raw": "{{baseUrl}}/api/v1/pagos/confirmar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pagos",
                "confirmar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"compra_id\": \"{{compraId}}\", \"datos_pasarela\": {\"monto_cobrado\": \"0.01\"}}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// PayPal real no acepta respuestas simuladas en datos_pasarela.",
                  "if (pm.environment.get('modoPago') === 'paypal') {",
                  "  console.log('Modo paypal: este paso solo aplica a la pasarela simulada.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
