                  "pm.test(\"Trae los creditos de bienvenida\", () => pm.expect(s.saldo).to.eql(10));",
                  "pm.test(\"Nada reservado\", () => pm.expect(s.reservado).to.eql(0));",
                  "pm.test(\"Disponible igual al saldo\", () => pm.expect(s.disponible).to.eql(10));"
                ]
              }
            }
          ]
