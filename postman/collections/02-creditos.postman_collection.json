                  "pm.test(\"No entrega tokens\", () => pm.expect(pm.response.json()).to.not.have.property(\"acceso\"));",
                  "pm.environment.set('desafio', pm.response.json().token_desafio);"
                ]
              }
            }
          ]
        },
        {
          "name": "Activar doble factor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/mfa/activar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "mfa",
                "activar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"token_desafio\": \"{{desafio}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const m = pm.response.json();",
                  "pm.test(\"Entrega el QR\", () => pm.expect(m.qr).to.include(\"data:image/png;base64,\"));",
                  "pm.environment.set('secreto', m.clave_manual);"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirmar y obtener tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/mfa/confirmar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "mfa",
                "confirmar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"token_desafio\": \"{{desafio}}\", \"codigo\": \"{{codigoTotp}}\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const totp = eval(pm.globals.get('libTotp'));",
                  "pm.environment.set('codigoTotp', totp(pm.environment.get('secreto'), 0));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.environment.set('acceso', t.acceso);",
                  "pm.environment.set('renovacion', t.renovacion);"
                ]
              }
            }
          ]
        }
      ]
