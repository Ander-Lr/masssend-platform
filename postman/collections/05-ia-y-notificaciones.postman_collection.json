              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"La tarea es UUIDv7\", () => pm.expect(pm.response.json().tarea_id[14]).to.eql(\"7\"));",
                  "const asunto = JSON.parse(pm.request.body.raw).asunto;",
                  "const ver = (n) => pm.sendRequest({ url: pm.environment.get('mailpitUrl') + '/api/v1/search?query=' + encodeURIComponent('subject:' + asunto) }, (e, r) => {",
                  "  const m = !e && r.json().messages || [];",
                  "  if (!m.length) { if (n > 0) return setTimeout(() => ver(n - 1), 300); throw new Error('No llego el correo'); }",
                  "  pm.test('El trabajador lo envio', () => pm.expect(m.length).to.eql(1));",
                  "});",
                  "if (pm.environment.get('modoCorreo') === 'gmail') { console.log('Modo gmail: revisa tu bandeja.'); } else { ver(40); }"
                ]
