        {
          "name": "Enviar con adjunto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{acceso}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notificaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "notificaciones"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "destinatario",
                  "value": "{{destinatario}}",
                  "type": "text"
                },
                {
                  "key": "asunto",
                  "value": "ConAdjunto",
                  "type": "text"
                },
                {
                  "key": "titulo",
                  "value": "Hola",
                  "type": "text"
                },
                {
                  "key": "mensaje",
                  "value": "Con archivo",
                  "type": "text"
                },
                {
                  "key": "archivo",
                  "type": "file",
                  "src": "archivos/prueba.pdf"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 202\", () => pm.response.to.have.status(202));",
                  "pm.environment.set('tareaAdjunto', pm.response.json().tarea_id);",
                  "const ver = (n) => pm.sendRequest({ url: pm.environment.get('mailpitUrl') + '/api/v1/search?query=' + encodeURIComponent('subject:ConAdjunto') }, (e, r) => {",
                  "  const m = !e && r.json().messages || [];",
                  "  if (!m.length) { if (n > 0) return setTimeout(() => ver(n - 1), 300); throw new Error('No llego el correo'); }",
                  "  pm.test('Llega con el adjunto', () => pm.expect(m[0].Attachments).to.eql(1));",
                  "});",
                  "if (pm.environment.get('modoCorreo') === 'gmail') { console.log('Modo gmail: revisa tu bandeja.'); } else { ver(40); }"
                ]
              }
            }
          ]
        },
