          "name": "Cuenta normal",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "salud"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Modo gmail: tucorreo+marca@gmail.com llega a tu misma bandeja y es una cuenta nueva.",
                  "if (pm.environment.get('modoCorreo') === 'gmail') {",
                  "  const real = pm.environment.get('correoReal') || '';",
                  "  if (!real.includes('@')) throw new Error('Define correoReal en el entorno MassSend local');",
                  "  const [usuario, dominio] = real.split('@');",
                  "  pm.environment.set('correo', usuario + '+' + Date.now() + '@' + dominio);",
                  "} else {",
                  "  pm.environment.set('correo', 'ana' + Date.now() + '@prueba.local');",
                  "}",
                  "pm.environment.set('correosVistos', 0);",
                  "// Calcula un TOTP (RFC 6238) a partir del secreto base32. Disponible en todas las peticiones.",
                  "pm.globals.set('libTotp', `(function (secreto, desplazamiento) {",
                  "  const abc = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
                  "  let bits = '';",
                  "  for (const c of secreto.replace(/=+$/, '').toUpperCase()) bits += abc.indexOf(c).toString(2).padStart(5, '0');",
                  "  let hex = '';",
                  "  for (let i = 0; i + 8 <= bits.length; i += 8) hex += parseInt(bits.substr(i, 8), 2).toString(16).padStart(2, '0');",
                  "  const paso = Math.floor(Date.now() / 30000) + (desplazamiento || 0);",
                  "  const msg = paso.toString(16).padStart(16, '0');",
                  "  const h = CryptoJS.HmacSHA1(CryptoJS.enc.Hex.parse(msg), CryptoJS.enc.Hex.parse(hex)).toString();",
                  "  const o = parseInt(h.substr(h.length - 1), 16);",
                  "  const n = parseInt(h.substr(o * 2, 8), 16) & 0x7fffffff;",
                  "  return String(n % 1000000).padStart(6, '0');",
                  "})`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar cuenta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\": \"Ana Lara\", \"correo\": \"{{correo}}\", \"contrasena\": \"clave-larga-123\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"El id es UUIDv7\", () => pm.expect(pm.response.json().id[14]).to.eql(\"7\"));",
                  "// Espera el correo en Mailpit y guarda codigo.",
                  "const correo = pm.environment.get('correo');",
                  "const leer = (restantes) => pm.sendRequest({",
                  "  url: pm.environment.get('mailpitUrl') + '/api/v1/search?query=' + encodeURIComponent('to:' + correo),",
                  "}, (e, r) => {",
                  "  const m = !e && r.json().messages || [];",
                  "  const vistos = Number(pm.environment.get('correosVistos') || 0);",
                  "  const nuevo = m.length > vistos ? m[0] : null;",
                  "  if (!nuevo) { if (restantes > 0) return setTimeout(() => leer(restantes - 1), 300); throw new Error('No llego el correo'); }",
                  "  pm.environment.set('correosVistos', m.length);",
                  "  pm.sendRequest({ url: pm.environment.get('mailpitUrl') + '/api/v1/message/' + nuevo.ID }, (e2, r2) => {",
                  "    const v = r2.json().Text.match(/\\b(\\d{6})\\b/)[1];",
                  "    pm.environment.set('codigo', v);",
                  "  });",
                  "});",
                  "if (pm.environment.get('modoCorreo') === 'gmail') { console.log('Modo gmail: revisa tu bandeja y copia el valor en el entorno.'); } else { leer(40); }"
                ]
              }
            }
          ]
        },
