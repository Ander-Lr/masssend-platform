{
  "info": {
    "name": "01 Identidad",
    "description": "Plataforma de la API v1. Las peticiones de identidad se agregan en los pasos siguientes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Plataforma",
      "item": [
        {
          "name": "Salud",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "salud"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test(\"La API esta sana\", () => pm.expect(c.estado).to.eql(\"ok\"));",
                  "pm.test(\"Base y Redis responden\", () => pm.expect(c.dependencias).to.eql({base_datos: \"ok\", cache: \"ok\"}));",
                  "pm.test(\"Informa la version\", () => pm.expect(c.version).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ruta inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/no-existe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "no-existe"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Es problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
                  "pm.test(\"Trae el codigo recurso_no_encontrado\", () => pm.expect(pm.response.json().codigo).to.eql(\"recurso_no_encontrado\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Metodo no permitido",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "salud"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 405\", () => pm.response.to.have.status(405));",
                  "pm.test(\"Es problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
                  "pm.test(\"Trae el codigo metodo_no_permitido\", () => pm.expect(pm.response.json().codigo).to.eql(\"metodo_no_permitido\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ruta actual sigue funcionando",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/csrf/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "csrf"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ruta actual conserva su formato",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/perfil/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "perfil"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"No es problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.not.include(\"problem+json\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}