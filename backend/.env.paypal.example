# Copia este archivo a backend/.env.paypal y completa los valores.
# backend/.env.paypal no se sube al repositorio.
# Postman: modoPago=paypal
# Solo PayPal deja de simularse; PayPhone tiene su propio archivo.
PASARELA_PAYPAL_CI=real
# Client ID y Secret de una app de PayPal Developer en modo Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Opcional. Vacio usa Sandbox (dinero ficticio). No pongas la URL live para pruebas.
PAYPAL_BASE_URL=
