# Copia este archivo a backend/.env.google y completa los valores.
# backend/.env.google no se sube al repositorio.
# Postman: modoGoogle=google
PROVEEDOR_GOOGLE_CI=google
# ID de cliente OAuth de tipo "Aplicacion web" (termina en .apps.googleusercontent.com).
GOOGLE_CLIENT_ID=
# Secreto del mismo cliente (empieza con GOCSPX-).
GOOGLE_CLIENT_SECRET=
# Opcional. Vacio usa http://localhost:8000/api/v1/auth/google/callback: el navegador
# que vuelve de Google pasa solo a la web (http://localhost:5173), que completa el acceso.
# Debe ser identica a la URI autorizada en Google Cloud.
GOOGLE_RETORNO_V1=
