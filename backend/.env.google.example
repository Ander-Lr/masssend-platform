# Copia este archivo a backend/.env.google y completa los valores.
# backend/.env.google no se sube al repositorio.
# Postman: modoGoogle=google
PROVEEDOR_GOOGLE_CI=google
# ID de cliente OAuth de tipo "Aplicacion web" (termina en .apps.googleusercontent.com).
GOOGLE_CLIENT_ID=
# Secreto del mismo cliente (empieza con GOCSPX-).
GOOGLE_CLIENT_SECRET=
# Opcional. Vacio usa http://localhost:8000/api/v1/auth/google/callback, que muestra
# el token_desafio en el navegador (util para Postman).
# Para entrar con Google desde la web usa http://localhost:5173/auth/google/callback.
# Debe ser identica a la URI autorizada en Google Cloud (puedes autorizar las dos).
GOOGLE_RETORNO_V1=
