# Copia este archivo a backend/.env.payphone y completa los valores.
# backend/.env.payphone no se sube al repositorio.
# Postman: modoPayphone=payphone
# Solo PayPhone deja de simularse; PayPal tiene su propio archivo.
PASARELA_PAYPHONE_CI=real
# Pestana Credenciales de tu aplicacion WEB en Payphone Developer (ambiente PRUEBAS).
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
# Opcional. Vacio usa https://pay.payphonetodoesposible.com (pruebas y produccion).
PAYPHONE_BASE_URL=
# Opcional. Vacio usa http://localhost:5173/billing/return?provider=payphone.
# Debe coincidir con la URL de Respuesta registrada en la aplicacion.
PAYPHONE_RETORNO_V1=
